{
  "name": "@home-assistant-matter-hub/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "cleanup": "pnpm -r run cleanup && pnpm run cleanup:root",
    "cleanup:root": "npx rimraf node_modules",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "pretest": "pnpm run build:minimum",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "build:minimum": "pnpm --filter @home-assistant-matter-hub/common run build",
    "build:app": "pnpm --filter './packages/*' run build",
    "preserve": "pnpm run build:minimum",
    "serve": "pnpm -r --parallel run serve",
    "start": "pnpm run serve",
    "preproduction": "pnpm run build:app",
    "production": "pnpm --filter home-assistant-matter-hub run start",
    "check-updates": "npx npm-check-updates --workspaces --root -u",
    "release": "semantic-release",
    "release:version": "pnpm version --workspaces --no-workspaces-update --no-git-tag-version --allow-same-version",
    "release:pack": "pnpm --filter home-assistant-matter-hub run bundle",
    "release:publish": "pnpm publish apps/home-assistant-matter-hub/package.tgz --provenance --no-git-checks --access public --loglevel verbose --tag ${CHANNEL:-latest}"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ],
  "pnpm": {
    "overrides": {
      "path-to-regexp@<8.4.0": "^8.4.0",
      "minimatch@<5.1.8": "5.1.8",
      "minimatch@<9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "rollup@<4.59.0": "^4.59.0",
      "undici@<6.29.1": "^6.29.1",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "handlebars@<4.7.10": "^4.7.10",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "yaml@<2.0.0": "^1.10.3",
      "@codemirror/state": "6.6.0",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "fast-uri@<3.1.9": "^3.1.9",
      "qs@<6.16.1": "^6.16.1",
      "markdown-it@<14.3.3": "^14.3.3",
      "esbuild@<0.28.1": "^0.28.1",
      "js-yaml@<4.3.1": "^4.3.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "postcss@<8.5.23": "^8.5.23",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "fast-copy@>=3.0.0 <3.1.0": "^3.1.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.3",
    "@dotenvx/dotenvx": "^1.61.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.30",
    "@swc/helpers": "~0.5.21",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-noexternal": "^0.1.6",
    "globals": "^17.5.0",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^21.0.2",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
